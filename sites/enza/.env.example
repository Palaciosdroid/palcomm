# Admin-Bereich (/admin)
ADMIN_PASSWORD=

# Signiert das Session-Cookie. Ohne diesen Wert startet der Admin-Bereich
# nicht und Inhalte lassen sich nicht speichern.
# Erzeugen mit: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Redis für die Inhalte
REDIS_URL=

# Resend API Key (for contact form emails)
# Get your API key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxx

# Contact Email (where form submissions are sent)
CONTACT_EMAIL=hypnoseenza@gmail.com

# Resend From Email (must be verified domain or use resend.dev for testing)
# For production: noreply@your-verified-domain.com
# For testing: Hypnose Enza <onboarding@resend.dev>
RESEND_FROM_EMAIL=Hypnose Enza <onboarding@resend.dev>

# Site URL for redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hero Video URL (optional - use CDN like Cloudflare R2 for faster loading)
# Leave empty to use local /videos/nature-bg.mp4
NEXT_PUBLIC_HERO_VIDEO_URL=

# Social Media Links (optional - only shown if set)
# Example: https://facebook.com/hypnoseenza
NEXT_PUBLIC_FACEBOOK_URL=
# Example: https://instagram.com/hypnoseenza
NEXT_PUBLIC_INSTAGRAM_URL=
