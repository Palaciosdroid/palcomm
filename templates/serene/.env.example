# --- Admin-Bereich (Pflicht) ---
# Passwort für /admin
ADMIN_PASSWORD=

# Signiert das Session-Cookie. Ohne diesen Wert ist der Admin-Bereich nicht
# nutzbar und Inhalte lassen sich nicht speichern.
# Erzeugen mit: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# --- Inhalte (Pflicht für den Betrieb) ---
# Redis-Verbindung. Ohne diese liegen Änderungen nur im Arbeitsspeicher und
# sind beim nächsten Neustart weg — nur für lokale Entwicklung akzeptabel.
REDIS_URL=

# --- Kontaktformular ---
# API-Key von https://resend.com
RESEND_API_KEY=

# Adresse, an die Formularanfragen gehen. Leer = E-Mail aus dem Content.
CONTACT_EMAIL=

# Absender. Muss eine bei Resend verifizierte Domain sein.
RESEND_FROM_EMAIL=
